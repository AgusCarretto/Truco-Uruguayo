<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Discord.Net.Interactions" Version="3.20.1" />
    <PackageReference Include="Discord.Net.WebSocket" Version="3.20.1" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <!-- Fijado en la ultima version 2.1.x (Apache 2.0, sin licencia comercial): las 3.x/4.x
         de ImageSharp pasaron a un licenciamiento pago (Six Labors Split License) cuyo
         build target directamente FALLA el build en entornos de CI que no tengan una
         licencia cargada (Railway, GitHub Actions, etc. setean CI=true); localmente solo
         se veia como warning porque no corriamos con esa variable seteada. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrucoUruguayo.Core\TrucoUruguayo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets\cartas\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="assets\fondos\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
