# Token del bot (Discord Developer Portal > Bot > Reset Token)
DISCORD_TOKEN=

# Cadena de conexion a Postgres (hay que crear la base y correr src/TrucoUruguayo.Bot/Datos/schema.sql contra ella antes de arrancar el bot)
DB_CONNECTION_STRING=Host=localhost;Database=postgres;Username=postgres;Password=postgres

# Opcional. Si lo completas, los slash commands se registran solo en ese servidor (cambios
# visibles al instante — util mientras desarrollas/probas). Si lo dejas vacio, se registran
# globalmente para que el bot funcione en cualquier servidor donde lo agreguen (tarda hasta
# ~1 hora en propagarse la primera vez).
DISCORD_GUILD_ID=
