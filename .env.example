# Usado por docker-compose (docker-compose.yml lee un .env en esta misma carpeta).
# Copialo a ".env" y completa el token. Si corres el bot con "dotnet run" en vez de Docker,
# usa src/TrucoUruguayo.Bot/.env.example en su lugar.

DISCORD_TOKEN=

# Opcional -- ver src/TrucoUruguayo.Bot/.env.example para la explicacion completa.
DISCORD_GUILD_ID=
